%%{
    common = args.common
%%}
<?xml version="1.0" encoding="UTF-8"?>
<!-- IAR Project Connection File -->
<iarProjectConnection version="1.6" name="SysConfig syscfg Files" oneShot="false"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="IarProjectConnection_1.8.xsd">
    <files>
% if ( args.project.syscfgfile ) {
    <path>$PROJ_DIR$/syscfg/ti_drivers_config.c</path>
    <path>$PROJ_DIR$/syscfg/ti_drivers_config.h</path>
    <path>$PROJ_DIR$/syscfg/ti_drivers_open_close.c</path>
    <path>$PROJ_DIR$/syscfg/ti_drivers_open_close.h</path>
    <path>$PROJ_DIR$/syscfg/ti_dpl_config.c</path>
    <path>$PROJ_DIR$/syscfg/ti_dpl_config.h</path>
    <path>$PROJ_DIR$/syscfg/ti_pinmux_config.c</path>
    <path>$PROJ_DIR$/syscfg/ti_power_clock_config.c</path>
    <path>$PROJ_DIR$/syscfg/ti_board_config.c</path>
    <path>$PROJ_DIR$/syscfg/ti_board_config.h</path>
    <path>$PROJ_DIR$/syscfg/ti_board_open_close.c</path>
    <path>$PROJ_DIR$/syscfg/ti_board_open_close.h</path>
    <path>$PROJ_DIR$/syscfg/linker.icf</path>
% for(val of args.project.libs["common"]){
	% if (val.startsWith("enet")) {
   <path>$PROJ_DIR$/syscfg/ti_enet_config.c</path>
   <path>$PROJ_DIR$/syscfg/ti_enet_config.h</path>
   <path>$PROJ_DIR$/syscfg/ti_enet_dma_init.c</path>
   <path>$PROJ_DIR$/syscfg/ti_enet_dma_init.h</path>
   <path>$PROJ_DIR$/syscfg/ti_enet_init.c</path>
   <path>$PROJ_DIR$/syscfg/ti_enet_open_close.c</path>
   <path>$PROJ_DIR$/syscfg/ti_enet_open_close.h</path>
   <path>$PROJ_DIR$/syscfg/ti_enet_soc.c</path>
   <path>$PROJ_DIR$/syscfg/ti_enet_lwipif.c</path>
   <path>$PROJ_DIR$/syscfg/ti_enet_lwipif.h</path>
		 % }
		% if ((args.project.device == "am261x") && (val.includes("tusb"))){
   <path>$PROJ_DIR$/syscfg/ti_usb_descriptor.c</path>
   <path>$PROJ_DIR$/syscfg/ti_usb_config.h</path>
		% }
	% }
% if (args.project.isBootLoader  && ( (args.project.device == "am263x") || (args.project.device == "am263px") || (args.project.device == "am261x"))){
   <path>$PROJ_DIR$/syscfg/ti_clocktree_pll_config.c</path>
   <path>$PROJ_DIR$/syscfg/ti_clocktree_pll_config.h</path>
%}
% }
    </files>
</iarProjectConnection>

    uart/v0/lld/dma/edma \
    watchdog/v0 \
    optiflash/v0/flc \
    optiflash/v0/rl2 \
    flsopskd/v0 \
    fota_agent/v0 \
    fss/v0 \
    pmu \
    pmu/r5f \
    pmu/r5f/iar-arm \

THIRD_PARTY_FILE_common := \
    epwm/v1 \
    ospi/v0/lld/dma/edma \
    soc/am261x \

INCLUDES_common := \
    -I${MCU_PLUS_SDK_PATH}/source \
    -I${MCU_PLUS_SDK_PATH}/source/security \

DEFINES_common := \
    -DSOC_AM261X \
    -DOS_NORTOS \

CFLAGS_common := \
    --cpu=Cortex-R5 \
    --fpu=VFPv3_D16 \
    --cpu_mode thumb \
    --debug \
    --diag_suppress=Pa039 \
    --diag_suppress=Pe177 \
    -e \
    --endian=little \
    --silent \
    --diag_suppress=Pe177 \

CFLAGS_release := \
    -Oh \
    -Ohz \

CFLAGS_cpp_common := \

CFLAGS_debug := \
    -D_DEBUG_=1 \

ASMFLAGS_common := \
    --cpu=Cortex-R5 \
    --fpu=VFPv3_D16 \

ARFLAGS_common := \
    --create \

FILES := $(FILES_common) $(FILES_$(PROFILE))
ASMFILES := $(ASMFILES_common) $(ASMFILES_$(PROFILE))
FILES_PATH := $(FILES_PATH_common) $(FILES_PATH_$(PROFILE))
CFLAGS := $(CFLAGS_common) $(CFLAGS_$(PROFILE))
ASMFLAGS := $(ASMFLAGS_common)
THIRD_PARTY_FILE_PATH := $(THIRD_PARTY_FILE_common)
ifeq ($(CPLUSPLUS_BUILD), yes)
CFLAGS += $(CFLAGS_cpp_common)
endif
DEFINES := $(DEFINES_common) $(DEFINES_$(PROFILE))
INCLUDES := $(INCLUDES_common) $(INCLUDE_$(PROFILE))
ARFLAGS := $(ARFLAGS_common) $(ARFLAGS_$(PROFILE))

LIBDIR := lib
OBJDIR := obj/am261x/iar-arm/$(PROFILE)/r5f/drivers/nortos/
OBJS := $(FILES:%.c=%.obj)
OBJS += $(ASMFILES:%.S=%.obj)
DEPS := $(FILES:%.c=%.d)

vpath %.obj $(OBJDIR)
vpath %.c $(FILES_PATH)
vpath %.S $(FILES_PATH)

$(OBJDIR)/%.obj %.obj: %.c
	@echo  Compiling: $(LIBNAME): $<
	$(CC) $(CFLAGS) \
    $(foreach file, $(THIRD_PARTY_FILE_PATH), $(if $(findstring $(file), $<), --no_warnings)) \
    $(INCLUDES) $(DEFINES) -o $(OBJDIR)/$@ $<

$(OBJDIR)/%.obj %.obj: %.S
	@echo  Compiling: $(LIBNAME): $<
	$(AS) $(ASMFLAGS) $(INCLUDES) $(DEFINES) -o $(OBJDIR)/$@ $<

all: $(LIBDIR)/$(LIBNAME)

$(LIBDIR)/$(LIBNAME): $(OBJS) | $(LIBDIR)
	@echo  .
	@echo  Archiving: $(LIBNAME) to $@ ...
	$(AR) $(ARFLAGS) $@ $(addprefix $(OBJDIR), $(OBJS))
	@echo  Archiving: $(LIBNAME) Done !!!
	@echo  .

clean:
	@echo  Cleaning: $(LIBNAME) ...
	$(RMDIR) $(OBJDIR)
	$(RM) $(LIBDIR)/$(LIBNAME)

scrub:
	@echo  Scrubing: $(LIBNAME) ...
	-$(RMDIR) obj/
	-$(RMDIR) lib/

$(OBJS): | $(OBJDIR)

$(LIBDIR) $(OBJDIR):
	$(MKDIR) $@

-include $(addprefix $(OBJDIR)/, $(DEPS))

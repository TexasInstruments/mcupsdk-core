    gpmc/v0 \
    gpmc/v0/dma \
    i2c/v1 \
    i2c/v1/lld \
    ipc_notify/v1 \
    ipc_notify/v1/soc/am261x \
    ipc_rpmsg/ \
    lin/v0 \

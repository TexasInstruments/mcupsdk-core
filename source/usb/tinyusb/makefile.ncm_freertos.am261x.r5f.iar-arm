
export MCU_PLUS_SDK_PATH?=$(abspath ../../..)
include $(MCU_PLUS_SDK_PATH)/imports.mak

CG_TOOL_ROOT=$(CGT_IAR_ARM_PATH)

CC=$(CGT_IAR_ARM_PATH)/bin/iccarm
AR=$(CGT_IAR_ARM_PATH)/bin/iarchive
AS=$(CGT_IAR_ARM_PATH)/bin/iasmarm

PROFILE?=release
ConfigName:=$(PROFILE)

LIBNAME:=usbd_tusb_ncm_freertos.am261x.r5f.iar-arm.$(PROFILE).lib

FILES_common := \
    usb_app_init.c \
    device_wrapper.c \
    dcd.c \
    tusb.c \
    tusb_fifo.c \
    usbd.c \
    usbd_control.c \
    ncm_device.c \
    no_os_gadget.c \
    dhserver.c \
    dnserver.c \
    altcp.c \
    altcp_alloc.c \
    altcp_tcp.c \
    def.c \
    dns.c \
    inet_chksum.c \
    init.c \
    ip.c \
    mem.c \
    memp.c \
    netif.c \
    pbuf.c \
    raw.c \
    stats.c \
    sys.c \
    tcp.c \
    tcp_in.c \
    tcp_out.c \
    timeouts.c \
    udp.c \
    autoip.c \
    dhcp.c \
    etharp.c \
    icmp.c \
    igmp.c \
    ip4.c \
    ip4_addr.c \
    ip4_frag.c \
    ethernet.c \
    slipif.c \
    httpd.c \
    lwiperf.c \
    fs.c \
    err.c \

FILES_PATH_common = \
    ../tinyusb/tinyusb-stack_0.20.0/src \
    ../tinyusb/tinyusb-stack_0.20.0/src/common \
    ../tinyusb/tinyusb-stack_0.20.0/src/device \
    ../tinyusb/tinyusb-stack_0.20.0/src/class/net \
    ../tinyusb/portable/am261x \
    ../synp/ \
    ../synp/dwc3/ \
    ../synp/include \
    ../synp/soc/ \
    ../synp/soc/am261x \
    ../tinyusb/tinyusb-stack_0.20.0/lib/networking \
    ../../networking/lwip/lwip-stack/src/core \
    ../../networking/lwip/lwip-stack/src/api \
    ../../networking/lwip/lwip-stack/src/core/ipv4 \
    ../../networking/lwip/lwip-stack/src/netif \
    ../../networking/lwip/lwip-stack/src/apps/http/ \
    ../../networking/lwip/lwip-stack/src/apps/lwiperf/ \

THIRD_PARTY_FILE_common := \
    tinyusb-stack_0.20.0/ \

INCLUDES_common := \
    -I${MCU_PLUS_SDK_PATH}/source \
    -I../../drivers/hw_include \
    -I../../drivers/hw_include/am261x \
    -I../../drivers/soc/am261x \
    -I../../kernel/freertos/FreeRTOS-Kernel/include \
    -I../../kernel/freertos/config/am261x/r5f \
    -I../tinyusb/config/freertos/am261x/ncm_config \
    -I../tinyusb/tinyusb-stack_0.20.0/src \
    -I../tinyusb/tinyusb-stack_0.20.0/src/common \
    -I../tinyusb/tinyusb-stack_0.20.0/src/device \
    -I../tinyusb/tinyusb-stack_0.20.0/src/class/net \
    -I../synp/ \
    -I../synp/dwc3/ \
    -I../synp/include \
    -I../synp/soc/ \
    -I../synp/soc/am261x \
    -I../tinyusb/tinyusb-stack_0.20.0/lib/networking \
    -I../../networking/lwip/lwip-stack/src/include \
    -I../../networking/lwip/lwip-stack/src/include/ipv4 \
    -I../../networking/lwip/lwip-stack/src/include/lwip/apps \
    -I../../networking/lwip/lwip-stack/src/include/lwip \
    -I../../networking/lwip/lwip-config/am261x/usb/ \
    -I../../networking/lwip/lwip-port/include/ \
    -I../../kernel/freertos/portable/IAR_ARM/ARM_CR5F \
    -I${MCU_PLUS_SDK_PATH}/source/kernel/freertos/FreeRTOS-Kernel/include \
    -I${MCU_PLUS_SDK_PATH}/source/kernel/freertos/portable/IAR_ARM/ARM_CR5F \
    -I${MCU_PLUS_SDK_PATH}/source/kernel/freertos/config/am261x/r5f \

DEFINES_common := \
    -DSOC_AM261X \
    -DTINYUSB_INTEGRATION \
    -DOS_FREERTOS \

DEFINES_debug := \

DEFINES_release := \

CFLAGS_common := \
    --cpu=Cortex-R5 \
    --fpu=VFPv3_D16 \
    --cpu_mode thumb \
    --debug \
    --diag_suppress=Pa039 \
    --diag_suppress=Pe177 \
    -e \
    --endian=little \
    --silent \
    --diag_suppress=Pe111 \

CFLAGS_cpp_common := \

CFLAGS_debug := \
    -D_DEBUG_=1 \

CFLAGS_release := \
    -Oh \

ASMFLAGS_common := \
    --cpu=Cortex-R5 \
    --fpu=VFPv3_D16 \

ARFLAGS_common := \
    --create \

FILES := $(FILES_common) $(FILES_$(PROFILE))
ASMFILES := $(ASMFILES_common) $(ASMFILES_$(PROFILE))
FILES_PATH := $(FILES_PATH_common) $(FILES_PATH_$(PROFILE))
CFLAGS := $(CFLAGS_common) $(CFLAGS_$(PROFILE))
ASMFLAGS := $(ASMFLAGS_common)
THIRD_PARTY_FILE_PATH := $(THIRD_PARTY_FILE_common)
DEFINES := $(DEFINES_common) $(DEFINES_$(PROFILE))
INCLUDES := $(INCLUDES_common) $(INCLUDE_$(PROFILE))
ARFLAGS := $(ARFLAGS_common) $(ARFLAGS_$(PROFILE))

LIBDIR := lib
OBJDIR := obj/am261x/iar-arm/$(PROFILE)/r5f/usbd_tusb_ncm_freertos/freertos/
OBJS := $(FILES:%.c=%.obj)
OBJS += $(ASMFILES:%.S=%.obj)
DEPS := $(FILES:%.c=%.d)

vpath %.obj $(OBJDIR)
vpath %.c $(FILES_PATH)
vpath %.S $(FILES_PATH)

$(OBJDIR)/%.obj %.obj: %.c
	@echo  Compiling: $(LIBNAME): $<
	$(CC) $(CFLAGS) \
    $(foreach file, $(THIRD_PARTY_FILE_PATH), $(if $(findstring $(file), $<), --no_warnings)) \
    $(INCLUDES) $(DEFINES) -o $(OBJDIR)/$@ $<

$(OBJDIR)/%.obj %.obj: %.S
	@echo  Compiling: $(LIBNAME): $<
	$(AS) $(ASMFLAGS) $(INCLUDES) $(DEFINES) -o $(OBJDIR)/$@ $<

all: $(LIBDIR)/$(LIBNAME)

$(LIBDIR)/$(LIBNAME): $(OBJS) | $(LIBDIR)
	@echo  .
	@echo  Archiving: $(LIBNAME) to $@ ...
	$(AR) $(ARFLAGS) $@ $(addprefix $(OBJDIR), $(OBJS))
	@echo  Archiving: $(LIBNAME) Done !!!
	@echo  .

clean:
	@echo  Cleaning: $(LIBNAME) ...
	$(RMDIR) $(OBJDIR)
	$(RM) $(LIBDIR)/$(LIBNAME)

scrub:
	@echo  Scrubing: $(LIBNAME) ...
	-$(RMDIR) obj/
	-$(RMDIR) lib/

$(OBJS): | $(OBJDIR)

$(LIBDIR) $(OBJDIR):
	$(MKDIR) $@

-include $(addprefix $(OBJDIR)/, $(DEPS))


export MCU_PLUS_SDK_PATH?=$(abspath ../../..)
include $(MCU_PLUS_SDK_PATH)/imports.mak

CG_TOOL_ROOT=$(CGT_IAR_ARM_PATH)

CC=$(CGT_IAR_ARM_PATH)/bin/iccarm
AR=$(CGT_IAR_ARM_PATH)/bin/iarchive
AS=$(CGT_IAR_ARM_PATH)/bin/iasmarm

PROFILE?=release
ConfigName:=$(PROFILE)

LIBNAME:=usbd_tusb_dfu_nortos.am261x.r5f.iar-arm.$(PROFILE).lib

FILES_common := \
    usb_app_init.c \
    device_wrapper.c \
    dcd.c \
    tusb.c \
    tusb_fifo.c \
    usbd.c \
    usbd_control.c \
    dfu_device.c \
    no_os_gadget.c \

FILES_PATH_common = \
    ../tinyusb/tinyusb-stack/src \
    ../tinyusb/tinyusb-stack/src/common \
    ../tinyusb/tinyusb-stack/src/device \
    ../tinyusb/tinyusb-stack/src/class/dfu \
    ../tinyusb/portable/am261x \
    ../synp/ \
    ../synp/dwc3/ \
    ../synp/include \
    ../synp/soc/ \
    ../synp/soc/am261x \

INCLUDES_common := \
    -I${MCU_PLUS_SDK_PATH}/source \
    -I../../drivers/hw_include \
    -I../../drivers/hw_include/am261x \
    -I../../drivers/soc/am261x \
    -I../tinyusb/config/nortos/am261x \
    -I../tinyusb/tinyusb-stack/src \
    -I../tinyusb/tinyusb-stack/src/common \
    -I../tinyusb/tinyusb-stack/src/device \
    -I../tinyusb/tinyusb-stack/src/class/dfu \
    -I../tinyusb/config/nortos/am261x/dfu_config \
    -I../synp/ \
    -I../synp/dwc3/ \
    -I../synp/include \
    -I../synp/soc/ \
    -I../synp/soc/am261x \

DEFINES_common := \
    -DSOC_AM261X \
    -DTINYUSB_INTEGRATION \
    -DOS_NORTOS \

DEFINES_debug := \

DEFINES_release := \

CFLAGS_common := \
    --cpu=Cortex-R5 \
    --fpu=VFPv3_D16 \
    --cpu_mode thumb \
    --debug \
    --diag_suppress=Pa039 \
    --diag_suppress=Pe177 \
    -e \
    --endian=little \
    --silent \

CFLAGS_cpp_common := \

CFLAGS_debug := \
    -D_DEBUG_=1 \

CFLAGS_release := \
    -Oh \

ASMFLAGS_common := \
    --cpu=Cortex-R5 \
    --fpu=VFPv3_D16 \

ARFLAGS_common := \
    --create \

FILES := $(FILES_common) $(FILES_$(PROFILE))
ASMFILES := $(ASMFILES_common) $(ASMFILES_$(PROFILE))
FILES_PATH := $(FILES_PATH_common) $(FILES_PATH_$(PROFILE))
CFLAGS := $(CFLAGS_common) $(CFLAGS_$(PROFILE))
ASMFLAGS := $(ASMFLAGS_common)
ifeq ($(CPLUSPLUS_BUILD), yes)
CFLAGS += $(CFLAGS_cpp_common)
endif
DEFINES := $(DEFINES_common) $(DEFINES_$(PROFILE))
INCLUDES := $(INCLUDES_common) $(INCLUDE_$(PROFILE))
ARFLAGS := $(ARFLAGS_common) $(ARFLAGS_$(PROFILE))

LIBDIR := lib
OBJDIR := obj/am261x/iar-arm/$(PROFILE)/r5f/usbd_tusb_dfu_nortos/nortos/
OBJS := $(FILES:%.c=%.obj)
OBJS += $(ASMFILES:%.S=%.obj)
DEPS := $(FILES:%.c=%.d)

vpath %.obj $(OBJDIR)
vpath %.c $(FILES_PATH)
vpath %.S $(FILES_PATH)

$(OBJDIR)/%.obj %.obj: %.c
	@echo  Compiling: $(LIBNAME): $<
	$(CC) $(CFLAGS) $(INCLUDES) $(DEFINES) -o $(OBJDIR)/$@ $<

$(OBJDIR)/%.obj %.obj: %.S
	@echo  Compiling: $(LIBNAME): $<
	$(AS) $(ASMFLAGS) $(INCLUDES) $(DEFINES) -o $(OBJDIR)/$@ $<

all: $(LIBDIR)/$(LIBNAME)

$(LIBDIR)/$(LIBNAME): $(OBJS) | $(LIBDIR)
	@echo  .
	@echo  Archiving: $(LIBNAME) to $@ ...
	$(AR) $(ARFLAGS) $@ $(addprefix $(OBJDIR), $(OBJS))
	@echo  Archiving: $(LIBNAME) Done !!!
	@echo  .

clean:
	@echo  Cleaning: $(LIBNAME) ...
	$(RMDIR) $(OBJDIR)
	$(RM) $(LIBDIR)/$(LIBNAME)

scrub:
	@echo  Scrubing: $(LIBNAME) ...
	-$(RMDIR) obj/
	-$(RMDIR) lib/

$(OBJS): | $(OBJDIR)

$(LIBDIR) $(OBJDIR):
	$(MKDIR) $@

-include $(addprefix $(OBJDIR)/, $(DEPS))

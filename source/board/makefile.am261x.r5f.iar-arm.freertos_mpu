
export MCU_PLUS_SDK_PATH?=$(abspath ../..)
include $(MCU_PLUS_SDK_PATH)/imports.mak

CG_TOOL_ROOT=$(CGT_IAR_ARM_PATH)

CC=$(CGT_IAR_ARM_PATH)/bin/iccarm
AR=$(CGT_IAR_ARM_PATH)/bin/iarchive
AS=$(CGT_IAR_ARM_PATH)/bin/iasmarm

PROFILE?=release
ConfigName:=$(PROFILE)

LIBNAME:=board.am261x.r5f.iar-arm.freertos_mpu.$(PROFILE).lib

FILES_common := \
    eeprom.c \
    eeprom_cat24m.c \
    ethphy.c \
    ethphy_dp83869.c \
    ethphy_dp83826e.c \
    phy_common_priv.c \
    generic_phy.c \
    dp83tc812.c \
    dp83tg720.c \
    dp83869.c \
    dp83867.c \
    dp83822.c \
    dp83826.c \
    flash.c \
    flash_nor_ospi.c \
    flash_nand_ospi.c \
    ram.c \
    psram_gpmc.c \
    psram_ospi.c \
    led.c \
    led_gpio.c \
    led_tpic2810.c \
    nor_spi_sfdp.c \
    ioexp_tca6424.c \
    ioexp_tca6416.c \
    ioexp_tca6408.c \
    tida010997.c \
    hdc3020.c \
    bmi270.c \
    bmi270_firmware.c \

FILES_PATH_common = \
    eeprom \
    ethphy/icss_emac \
    ethphy/enet/rtos_drivers/src \
    ethphy/enet/rtos_drivers/include \
    flash \
    flash/sfdp \
    flash/ospi \
    ram \
    ram/gpmc \
    ram/ospi \
    led \
    ioexp \
    pmic \
    pmic/pmic_lld/src \
    tida010997 \
    tida010997/imu \
    tida010997/humidity_temperature \

INCLUDES_common := \
    -I${MCU_PLUS_SDK_PATH}/source \
    -Ipmic \
    -Ipmic/pmic_lld/src \
    -Ipmic/pmic_lld/include \
    -I${MCU_PLUS_SDK_PATH}/source/board/ethphy/enet/rtos_drivers/include \
    -I${MCU_PLUS_SDK_PATH}/source/board/ethphy/port \
    -I${MCU_PLUS_SDK_PATH}/source/kernel/freertos/FreeRTOS-Kernel/include \
    -I${MCU_PLUS_SDK_PATH}/source/kernel/freertos/portable/TI_ARM_CLANG/ARM_CR5F_MPU \
    -I${MCU_PLUS_SDK_PATH}/source/kernel/freertos/config/am261x/r5f_mpu \

DEFINES_common := \
    -DSOC_AM261X \
    -DMCU_SDK_BUILD \
    -DPHY_CFG_TRACE_LEVEL=3 \
    -DOS_FREERTOS_MPU \

CFLAGS_common := \
    --cpu=Cortex-R5 \
    --fpu=VFPv3_D16 \
    --cpu_mode thumb \
    --debug \
    --diag_suppress=Pa039 \
    --diag_suppress=Pe177 \
    -e \
    --endian=little \
    --silent \

CFLAGS_cpp_common := \

CFLAGS_debug := \
    -D_DEBUG_=1 \

CFLAGS_release := \
    -Oh \

ASMFLAGS_common := \
    --cpu=Cortex-R5 \
    --fpu=VFPv3_D16 \

ARFLAGS_common := \
    --create \

FILES := $(FILES_common) $(FILES_$(PROFILE))
ASMFILES := $(ASMFILES_common) $(ASMFILES_$(PROFILE))
FILES_PATH := $(FILES_PATH_common) $(FILES_PATH_$(PROFILE))
CFLAGS := $(CFLAGS_common) $(CFLAGS_$(PROFILE))
ASMFLAGS := $(ASMFLAGS_common)
ifeq ($(CPLUSPLUS_BUILD), yes)
CFLAGS += $(CFLAGS_cpp_common)
endif
DEFINES := $(DEFINES_common) $(DEFINES_$(PROFILE))
INCLUDES := $(INCLUDES_common) $(INCLUDE_$(PROFILE))
ARFLAGS := $(ARFLAGS_common) $(ARFLAGS_$(PROFILE))

LIBDIR := lib
OBJDIR := obj/am261x/iar-arm/$(PROFILE)/r5f/board/freertos_mpu/
OBJS := $(FILES:%.c=%.obj)
OBJS += $(ASMFILES:%.S=%.obj)
DEPS := $(FILES:%.c=%.d)

vpath %.obj $(OBJDIR)
vpath %.c $(FILES_PATH)
vpath %.S $(FILES_PATH)

$(OBJDIR)/%.obj %.obj: %.c
	@echo  Compiling: $(LIBNAME): $<
	$(CC) $(CFLAGS) $(INCLUDES) $(DEFINES) -o $(OBJDIR)/$@ $<

$(OBJDIR)/%.obj %.obj: %.S
	@echo  Compiling: $(LIBNAME): $<
	$(AS) $(ASMFLAGS) $(INCLUDES) $(DEFINES) -o $(OBJDIR)/$@ $<

all: $(LIBDIR)/$(LIBNAME)

$(LIBDIR)/$(LIBNAME): $(OBJS) | $(LIBDIR)
	@echo  .
	@echo  Archiving: $(LIBNAME) to $@ ...
	$(AR) $(ARFLAGS) $@ $(addprefix $(OBJDIR), $(OBJS))
	@echo  Archiving: $(LIBNAME) Done !!!
	@echo  .

clean:
	@echo  Cleaning: $(LIBNAME) ...
	$(RMDIR) $(OBJDIR)
	$(RM) $(LIBDIR)/$(LIBNAME)

scrub:
	@echo  Scrubing: $(LIBNAME) ...
	-$(RMDIR) obj/
	-$(RMDIR) lib/

$(OBJS): | $(OBJDIR)

$(LIBDIR) $(OBJDIR):
	$(MKDIR) $@

-include $(addprefix $(OBJDIR)/, $(DEPS))

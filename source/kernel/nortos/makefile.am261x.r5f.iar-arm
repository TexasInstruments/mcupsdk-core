
export MCU_PLUS_SDK_PATH?=$(abspath ../../..)
include $(MCU_PLUS_SDK_PATH)/imports.mak

CG_TOOL_ROOT=$(CGT_IAR_ARM_PATH)

CC=$(CGT_IAR_ARM_PATH)/bin/iccarm
AR=$(CGT_IAR_ARM_PATH)/bin/iarchive
AS=$(CGT_IAR_ARM_PATH)/bin/iasmarm

PROFILE?=release
ConfigName:=$(PROFILE)

LIBNAME:=nortos.am261x.r5f.iar-arm.$(PROFILE).lib

FILES_common := \
    AddrTranslateP_32bit.c \
    boot_armv7r.c \
    DebugP_shmLogWriter.c \
    DebugP_shmLogReader.c \
    DebugP_uartLogWriter.c \
    DebugP_uartScanf.c \
    DebugP_memTraceLogWriter.c \
    DebugP_log.c \
    DebugP_nortos.c \
    SemaphoreP_nortos.c \
    ClockP_nortos.c \
    ClockP_nortos_r5.c \
    CpuId_armv7r.c \
    EventP_nortos.c \
    HeapP_nortos.c \
    TimerP_rti_priv.c \
    TimerP_rti_nortos.c \
    TaskP_nortos.c \
    HwiP_armv7r_vim.c \
    HwiP_armv7r_handlers_nortos.c \
    MpuP_armv7r.c \
    CacheP_armv7r.c \
    HeapP_internal.c \
    printf.c \
    QueueP_nortos.c \
    PmuP_armv7r.c \

ASMFILES_common := \
    HwiP_armv7r_handlers_nortos_asm.S \
    HwiP_armv7r_vectors_nortos_asm.S \
    HwiP_armv7r_vectors_nortos_sbl_asm.S \
    boot_armv7r_asm.S \
    HwiP_armv7r_asm.S \
    MpuP_armv7r_asm.S \
    CacheP_armv7r_asm.S \
    CpuId_armv7r_asm.S \
    PmuP_armv7r_asm.S \
    Mutex_armv7r_asm.S \

FILES_PATH_common = \
    dpl/r5 \
    dpl/common \
    dpl/r5/iar-arm \

INCLUDES_common := \
    -I${MCU_PLUS_SDK_PATH}/source \

DEFINES_common := \
    -DSOC_AM261X \
    -DOS_NORTOS \

CFLAGS_common := \
    --cpu=Cortex-R5 \
    --fpu=VFPv3_D16 \
    --cpu_mode thumb \
    --debug \
    --diag_suppress=Pa039 \
    --diag_suppress=Pe177 \
    -e \
    --endian=little \
    --silent \
    --diag_suppress=Pe177 \

CFLAGS_cpp_common := \

CFLAGS_debug := \
    -D_DEBUG_=1 \

CFLAGS_release := \
    -Oh \

ASMFLAGS_common := \
    --cpu=Cortex-R5 \
    --fpu=VFPv3_D16 \

ARFLAGS_common := \
    --create \

FILES := $(FILES_common) $(FILES_$(PROFILE))
ASMFILES := $(ASMFILES_common) $(ASMFILES_$(PROFILE))
FILES_PATH := $(FILES_PATH_common) $(FILES_PATH_$(PROFILE))
CFLAGS := $(CFLAGS_common) $(CFLAGS_$(PROFILE))
ASMFLAGS := $(ASMFLAGS_common)
ifeq ($(CPLUSPLUS_BUILD), yes)
CFLAGS += $(CFLAGS_cpp_common)
endif
DEFINES := $(DEFINES_common) $(DEFINES_$(PROFILE))
INCLUDES := $(INCLUDES_common) $(INCLUDE_$(PROFILE))
ARFLAGS := $(ARFLAGS_common) $(ARFLAGS_$(PROFILE))

LIBDIR := lib
OBJDIR := obj/am261x/iar-arm/$(PROFILE)/r5f/nortos/nortos/
OBJS := $(FILES:%.c=%.obj)
OBJS += $(ASMFILES:%.S=%.obj)
DEPS := $(FILES:%.c=%.d)

vpath %.obj $(OBJDIR)
vpath %.c $(FILES_PATH)
vpath %.S $(FILES_PATH)

$(OBJDIR)/%.obj %.obj: %.c
	@echo  Compiling: $(LIBNAME): $<
	$(CC) $(CFLAGS) $(INCLUDES) $(DEFINES) -o $(OBJDIR)/$@ $<

$(OBJDIR)/%.obj %.obj: %.S
	@echo  Compiling: $(LIBNAME): $<
	$(AS) $(ASMFLAGS) $(INCLUDES) $(DEFINES) -o $(OBJDIR)/$@ $<

all: $(LIBDIR)/$(LIBNAME)

$(LIBDIR)/$(LIBNAME): $(OBJS) | $(LIBDIR)
	@echo  .
	@echo  Archiving: $(LIBNAME) to $@ ...
	$(AR) $(ARFLAGS) $@ $(addprefix $(OBJDIR), $(OBJS))
	@echo  Archiving: $(LIBNAME) Done !!!
	@echo  .

clean:
	@echo  Cleaning: $(LIBNAME) ...
	$(RMDIR) $(OBJDIR)
	$(RM) $(LIBDIR)/$(LIBNAME)

scrub:
	@echo  Scrubing: $(LIBNAME) ...
	-$(RMDIR) obj/
	-$(RMDIR) lib/

$(OBJS): | $(OBJDIR)

$(LIBDIR) $(OBJDIR):
	$(MKDIR) $@

-include $(addprefix $(OBJDIR)/, $(DEPS))

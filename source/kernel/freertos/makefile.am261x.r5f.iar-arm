
export MCU_PLUS_SDK_PATH?=$(abspath ../../..)
include $(MCU_PLUS_SDK_PATH)/imports.mak

CG_TOOL_ROOT=$(CGT_IAR_ARM_PATH)

CC=$(CGT_IAR_ARM_PATH)/bin/iccarm
AR=$(CGT_IAR_ARM_PATH)/bin/iarchive
AS=$(CGT_IAR_ARM_PATH)/bin/iasmarm

PROFILE?=release
ConfigName:=$(PROFILE)

LIBNAME:=freertos.am261x.r5f.iar-arm.$(PROFILE).lib

FILES_common := \
    boot_armv7r.c \
    DebugP_shmLogWriter.c \
    DebugP_shmLogReader.c \
    DebugP_uartLogWriter.c \
    DebugP_uartScanf.c \
    DebugP_memTraceLogWriter.c \
    DebugP_log.c \
    TimerP_rti_priv.c \
    HwiP_armv7r_vim.c \
    MpuP_armv7r.c \
    CacheP_armv7r.c \
    CpuId_armv7r.c \
    HeapP_internal.c \
    printf.c \
    AddrTranslateP.c \
    PmuP_armv7r.c \
    QueueP_nortos.c \
    ClockP_freertos.c \
    ClockP_freertos_r5.c \
    SemaphoreP_freertos.c \
    HwiP_armv7r_handlers_freertos.c \
    HeapP_freertos.c \
    DebugP_freertos.c \
    DebugP_shmLogReader_freertos.c \
    TaskP_freertos.c \
    EventP_freertos.c \
    MailboxP_freertos.c \
    TimerP_rti_freertos.c \
    event_groups.c \
    tasks.c \
    timers.c \
    queue.c \
    list.c \
    heap_3.c \
    FreeRTOS_POSIX_clock.c \
    FreeRTOS_POSIX_mqueue.c \
    FreeRTOS_POSIX_pthread_barrier.c \
    FreeRTOS_POSIX_pthread_cond.c \
    FreeRTOS_POSIX_pthread_mutex.c \
    FreeRTOS_POSIX_pthread.c \
    FreeRTOS_POSIX_sched.c \
    FreeRTOS_POSIX_semaphore.c \
    FreeRTOS_POSIX_timer.c \
    FreeRTOS_POSIX_unistd.c \
    FreeRTOS_POSIX_utils.c \
    port.c \

ASMFILES_common := \
    boot_armv7r_asm.S \
    HwiP_armv7r_asm.S \
    MpuP_armv7r_asm.S \
    CacheP_armv7r_asm.S \
    CpuId_armv7r_asm.S \
    PmuP_armv7r_asm.S \
    HwiP_armv7r_vectors_freertos_asm.S \
    HwiP_armv7r_handlers_freertos_asm.S \
    Mutex_armv7r_asm.S \
    portASM.S \

FILES_PATH_common = \
    ../nortos/dpl/r5 \
    ../nortos/dpl/common \
    dpl/common \
    dpl/r5 \
    FreeRTOS-Kernel/ \
    FreeRTOS-Kernel/portable/MemMang \
    FreeRTOS-POSIX/FreeRTOS-Plus-POSIX/source/ \
    portable/IAR_ARM/ARM_CR5F \
    ../nortos/dpl/r5/iar-arm/ \
    dpl/r5/iar-arm \

THIRD_PARTY_FILE_common := \
    FreeRTOS-Kernel/ \

INCLUDES_common := \
    -I${MCU_PLUS_SDK_PATH}/source \
    -IFreeRTOS-Kernel/include \
    -IFreeRTOS-POSIX/include \
    -IFreeRTOS-POSIX/include/private \
    -IFreeRTOS-POSIX/FreeRTOS-Plus-POSIX/include \
    -IFreeRTOS-POSIX/FreeRTOS-Plus-POSIX/include/portable \
    -Iportable/IAR_ARM/ARM_CR5F \
    -Iconfig/am261x/r5f \

DEFINES_common := \
    -DSOC_AM261X \
    -DOS_FREERTOS \

CFLAGS_common := \
    --cpu=Cortex-R5 \
    --fpu=VFPv3_D16 \
    --cpu_mode thumb \
    --debug \
    --diag_suppress=Pa039 \
    --diag_suppress=Pe177 \
    -e \
    --endian=little \
    --silent \
    --diag_suppress=Pe177 \

CFLAGS_cpp_common := \

CFLAGS_debug := \
    -D_DEBUG_=1 \

CFLAGS_release := \
    -Oh \

ASMFLAGS_common := \
    --cpu=Cortex-R5 \
    --fpu=VFPv3_D16 \

ARFLAGS_common := \
    --create \

FILES := $(FILES_common) $(FILES_$(PROFILE))
ASMFILES := $(ASMFILES_common) $(ASMFILES_$(PROFILE))
FILES_PATH := $(FILES_PATH_common) $(FILES_PATH_$(PROFILE))
CFLAGS := $(CFLAGS_common) $(CFLAGS_$(PROFILE))
ASMFLAGS := $(ASMFLAGS_common)
THIRD_PARTY_FILE_PATH := $(THIRD_PARTY_FILE_common)
ifeq ($(CPLUSPLUS_BUILD), yes)
CFLAGS += $(CFLAGS_cpp_common)
endif
DEFINES := $(DEFINES_common) $(DEFINES_$(PROFILE))
INCLUDES := $(INCLUDES_common) $(INCLUDE_$(PROFILE))
ARFLAGS := $(ARFLAGS_common) $(ARFLAGS_$(PROFILE))

LIBDIR := lib
OBJDIR := obj/am261x/iar-arm/$(PROFILE)/r5f/freertos/freertos/
OBJS := $(FILES:%.c=%.obj)
OBJS += $(ASMFILES:%.S=%.obj)
DEPS := $(FILES:%.c=%.d)

vpath %.obj $(OBJDIR)
vpath %.c $(FILES_PATH)
vpath %.S $(FILES_PATH)

$(OBJDIR)/%.obj %.obj: %.c
	@echo  Compiling: $(LIBNAME): $<
	$(CC) $(CFLAGS) \
    $(foreach file, $(THIRD_PARTY_FILE_PATH), $(if $(findstring $(file), $<), --no_warnings)) \
    $(INCLUDES) $(DEFINES) -o $(OBJDIR)/$@ $<

$(OBJDIR)/%.obj %.obj: %.S
	@echo  Compiling: $(LIBNAME): $<
	$(AS) $(ASMFLAGS) $(INCLUDES) $(DEFINES) -o $(OBJDIR)/$@ $<

all: $(LIBDIR)/$(LIBNAME)

$(LIBDIR)/$(LIBNAME): $(OBJS) | $(LIBDIR)
	@echo  .
	@echo  Archiving: $(LIBNAME) to $@ ...
	$(AR) $(ARFLAGS) $@ $(addprefix $(OBJDIR), $(OBJS))
	@echo  Archiving: $(LIBNAME) Done !!!
	@echo  .

clean:
	@echo  Cleaning: $(LIBNAME) ...
	$(RMDIR) $(OBJDIR)
	$(RM) $(LIBDIR)/$(LIBNAME)

scrub:
	@echo  Scrubing: $(LIBNAME) ...
	-$(RMDIR) obj/
	-$(RMDIR) lib/

$(OBJS): | $(OBJDIR)

$(LIBDIR) $(OBJDIR):
	$(MKDIR) $@

-include $(addprefix $(OBJDIR)/, $(DEPS))

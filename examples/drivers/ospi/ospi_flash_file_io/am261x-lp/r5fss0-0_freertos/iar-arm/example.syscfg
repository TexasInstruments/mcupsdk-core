i2c1.$name              = "CONFIG_I2C0";
ioexp1.peripheralDriver = i2c1;
i2c1.I2C.$assign        = "I2C0";
i2c1.I2C.SCL.$assign    = "GPIO135";
i2c1.I2C.SDA.$assign    = "GPIO134";
i2c1.I2C_child.$name    = "drivers_i2c_v1_i2c_v1_template0";

littlefs1.$name                                                     = "CONFIG_LITTLEFS0";
littlefs1.flashOffset                                               = "0x400000";
littlefs1.peripheralDriver.$name                                    = "CONFIG_FLASH0";
littlefs1.peripheralDriver.protocol                                 = "1s_1s_1s";
littlefs1.peripheralDriver.addressByteSupport                       = "1";
littlefs1.peripheralDriver.enable4BAddr                             = false;
littlefs1.peripheralDriver.enableFlashReset                         = true;
littlefs1.peripheralDriver.peripheralDriver.$name                   = "CONFIG_OSPI0";
littlefs1.peripheralDriver.peripheralDriver.OSPI.$assign            = "OSPI0";
littlefs1.peripheralDriver.peripheralDriver.OSPI.CLK.$assign        = "GPIO10";
littlefs1.peripheralDriver.peripheralDriver.OSPI.CSn0.$assign       = "GPIO62";
littlefs1.peripheralDriver.peripheralDriver.OSPI.DQS.$assign        = "GPIO9";
littlefs1.peripheralDriver.peripheralDriver.OSPI.D7.$assign         = "GPIO68";
littlefs1.peripheralDriver.peripheralDriver.OSPI.D6.$assign         = "GPIO8";
littlefs1.peripheralDriver.peripheralDriver.OSPI.D5.$assign         = "GPIO67";

littlefs1.peripheralDriver.peripheralDriver.OSPI.D1.$assign         = "GPIO70";
littlefs1.peripheralDriver.peripheralDriver.OSPI.D0.$assign         = "GPIO2";
littlefs1.peripheralDriver.peripheralDriver.OSPI.RESET_OUT0.$assign = "GPIO61";
littlefs1.peripheralDriver.peripheralDriver.child.$name             = "drivers_ospi_v0_ospi_v0_am261x_template0";


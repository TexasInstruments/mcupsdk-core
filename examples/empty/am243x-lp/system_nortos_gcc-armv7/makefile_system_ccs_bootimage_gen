
# Below variables need to be defined outside this file or via command line
# - MCU_PLUS_SDK_PATH
# - PROFILE
# - OUTNAME
# - CCS_INSTALL_DIR

CCS_PATH=$(CCS_INSTALL_DIR)
include $(MCU_PLUS_SDK_PATH)/imports.mak
include $(MCU_PLUS_SDK_PATH)/devconfig/devconfig.mak

ifeq ($(OS), Windows_NT)
	PYTHON=python
else
	PYTHON=python3
endif

MULTI_CORE_BOOTIMAGE_PATH=$(abspath $(PROFILE))
MULTI_CORE_BOOTIMAGE_NAME_MCELF:=$(PROFILE)/$(OUTNAME).mcelf

#
# Generation of multi-core boot image which can be loaded by Secondary Boot Loader (SBL)
#
ifeq ($(OS),Windows_NT)
EXE_EXT=.exe
endif
BOOTIMAGE_TEMP_OUT_FILE=$(PROFILE)/temp_stdout_$(PROFILE).txt

BOOTIMAGE_CORE_ID_r5fss0-0 = 4
BOOTIMAGE_CORE_ID_r5fss0-1 = 5
BOOTIMAGE_CORE_ID_r5fss1-0 = 6
BOOTIMAGE_CORE_ID_r5fss1-1 = 7
BOOTIMAGE_CORE_ID_m4fss0-0 = 14
SBL_RUN_ADDRESS=0x70000000
SBL_DEV_ID=55

APP_IMAGE_SIGN_CMD = $(MCU_PLUS_SDK_PATH)/source/security/security_common/tools/boot/signing/appimage_x509_cert_gen.py
MCELF_IMAGE_GEN = $(MCU_PLUS_SDK_PATH)/tools/boot/multicore-elf/genimage_am64x.py

MULTI_CORE_APP_PARAMS = \
	../empty_am243x-lp_r5fss0-0_nortos_gcc-armv7/$(PROFILE)/empty_am243x-lp_r5fss0-0_nortos_gcc-armv7.rprc@$(BOOTIMAGE_CORE_ID_r5fss0-0) \
	../empty_am243x-lp_r5fss0-1_nortos_gcc-armv7/$(PROFILE)/empty_am243x-lp_r5fss0-1_nortos_gcc-armv7.rprc@$(BOOTIMAGE_CORE_ID_r5fss0-1) \
	../empty_am243x-lp_r5fss1-0_nortos_gcc-armv7/$(PROFILE)/empty_am243x-lp_r5fss1-0_nortos_gcc-armv7.rprc@$(BOOTIMAGE_CORE_ID_r5fss1-0) \
	../empty_am243x-lp_r5fss1-1_nortos_gcc-armv7/$(PROFILE)/empty_am243x-lp_r5fss1-1_nortos_gcc-armv7.rprc@$(BOOTIMAGE_CORE_ID_r5fss1-1) \

MULTI_CORE_APP_PARAMS_XIP = \
	../empty_am243x-lp_r5fss0-0_nortos_gcc-armv7/$(PROFILE)/empty_am243x-lp_r5fss0-0_nortos_gcc-armv7.rprc_xip@$(BOOTIMAGE_CORE_ID_r5fss0-0) \
	../empty_am243x-lp_r5fss0-1_nortos_gcc-armv7/$(PROFILE)/empty_am243x-lp_r5fss0-1_nortos_gcc-armv7.rprc_xip@$(BOOTIMAGE_CORE_ID_r5fss0-1) \
	../empty_am243x-lp_r5fss1-0_nortos_gcc-armv7/$(PROFILE)/empty_am243x-lp_r5fss1-0_nortos_gcc-armv7.rprc_xip@$(BOOTIMAGE_CORE_ID_r5fss1-0) \
	../empty_am243x-lp_r5fss1-1_nortos_gcc-armv7/$(PROFILE)/empty_am243x-lp_r5fss1-1_nortos_gcc-armv7.rprc_xip@$(BOOTIMAGE_CORE_ID_r5fss1-1) \

CORE_IMG_ARGS :=

CORE_4_IMG=../empty_am243x-lp_r5fss0-0_nortos_gcc-armv7/$(PROFILE)/empty_am243x-lp_r5fss0-0_nortos_gcc-armv7.out
CORE_IMG_ARGS +=--core-img=4:$(CORE_4_IMG)

CORE_5_IMG=../empty_am243x-lp_r5fss0-1_nortos_gcc-armv7/$(PROFILE)/empty_am243x-lp_r5fss0-1_nortos_gcc-armv7.out
CORE_IMG_ARGS +=--core-img=5:$(CORE_5_IMG)

CORE_6_IMG=../empty_am243x-lp_r5fss1-0_nortos_gcc-armv7/$(PROFILE)/empty_am243x-lp_r5fss1-0_nortos_gcc-armv7.out
CORE_IMG_ARGS +=--core-img=6:$(CORE_6_IMG)

CORE_7_IMG=../empty_am243x-lp_r5fss1-1_nortos_gcc-armv7/$(PROFILE)/empty_am243x-lp_r5fss1-1_nortos_gcc-armv7.out
CORE_IMG_ARGS +=--core-img=7:$(CORE_7_IMG)

all:
ifeq ($(CCS_IDE_MODE),cloud)
#	No post build steps
else

	@echo  Boot multi-core ELF image: $@ ...

	$(PYTHON) $(MCELF_IMAGE_GEN) $(CORE_IMG_ARGS) --output=$(MULTI_CORE_BOOTIMAGE_NAME_MCELF) --xip=$(MCELF_XIP_RANGE)

	@echo  Boot multi-core ELF image: $(MULTI_CORE_BOOTIMAGE_PATH)/$@ Done !!!
	@echo  .

ifeq ($(DEVICE_TYPE),HS)
# Sign the appimage using appimage signing script
ifeq ($(ENC_ENABLED),no)
	@echo Boot image signing: Encryption is disabled.
	$(PYTHON) $(APP_IMAGE_SIGN_CMD) --bin $(MULTI_CORE_BOOTIMAGE_NAME_MCELF) --authtype 1 --key $(APP_SIGNING_KEY) --output $(MULTI_CORE_BOOTIMAGE_NAME_MCELF).hs
	$(RM) $(MULTI_CORE_BOOTIMAGE_NAME_MCELF)
else
	@echo Boot image signing: Encryption is enabled.
	$(PYTHON) $(APP_IMAGE_SIGN_CMD) --bin $(MULTI_CORE_BOOTIMAGE_NAME_MCELF) --authtype 1 --key $(APP_SIGNING_KEY) --enc y --enckey $(APP_ENCRYPTION_KEY) --output $(MULTI_CORE_BOOTIMAGE_NAME_MCELF).hs
	$(RM) $(MULTI_CORE_BOOTIMAGE_NAME_MCELF)-enc
endif
else
# Sign the appimage for HS-FS using appimage signing script
	$(PYTHON) $(APP_IMAGE_SIGN_CMD) --bin $(MULTI_CORE_BOOTIMAGE_NAME_MCELF) --authtype 1 --key $(APP_SIGNING_KEY) --output $(MULTI_CORE_BOOTIMAGE_NAME_MCELF).hs_fs
	$(RM) $(MULTI_CORE_BOOTIMAGE_NAME_MCELF)
endif

ifeq ($(DEVICE_TYPE),HS)
	@echo  Boot multi-core image: $(MULTI_CORE_BOOTIMAGE_NAME).hs Done !!!
	@echo  Boot multi-core image: $(MULTI_CORE_BOOTIMAGE_NAME_MCELF).hs Done !!!
else
	@echo  Boot multi-core image: $(MULTI_CORE_BOOTIMAGE_NAME).hs_fs Done !!!
endif
	@echo  .
endif

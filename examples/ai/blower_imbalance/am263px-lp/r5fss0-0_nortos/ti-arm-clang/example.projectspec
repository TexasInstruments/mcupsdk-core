<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="Cortex R.AM263Px"
            />
        </when>
    </applicability>

    <project
        title="Blower Imbalance"
        name = "blower_imbalance_am263px-lp_r5fss0-0_nortos_ti-arm-clang"
        products="sysconfig;com.ti.MCU_PLUS_SDK_AMXXX"
        configurations="
            Release,
            Debug,
        "
        connection="TIXDS110_Connection.xml"
        toolChain="TICLANG"
        cgtVersion="4.0.4.LTS"
        device="Cortex R.AM263Px"
        deviceCore="Cortex_R5_0"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        endianness="little"
        outputFormat="ELF"
        outputType="executable"

        compilerBuildOptions="
            -I${CG_TOOL_ROOT}/include/c
            -I${MCU_PLUS_SDK_PATH}/source
            -I${MCU_PLUS_SDK_PATH}/source
            -I${MCU_PLUS_SDK_PATH}/source/ai/feature_extract
            -I${MCU_PLUS_SDK_PATH}/source/ai/hann
            -I../../../artifacts
            -I../../..
            -I${PROJECT_ROOT}
            -mcpu=cortex-r5
            -mfloat-abi=hard
            -mfpu=vfpv3-d16
            -mthumb
            -Wall
            -Werror
            -g
            -Wno-gnu-variable-sized-type-not-at-end
            -Wno-unused-function
            -Wno-extern-initializer
            -Wno-unused-variable
            -DSOC_AM263PX
            -DSOC_AM263PX
            -DOS_NORTOS
        "
        linkerBuildOptions="
            -i${MCU_PLUS_SDK_PATH}/source/kernel/nortos/lib
            -i${MCU_PLUS_SDK_PATH}/source/drivers/lib
            -i${MCU_PLUS_SDK_PATH}/source/cmsis/lib
            -i../../../artifacts
            -i${CG_TOOL_ROOT}/lib
            -i${PROJECT_ROOT}
            -m=blower_imbalance.${ConfigName}.map
            --diag_suppress=10063
            --ram_model
            --reread_libs
            --gen_xml_func_hash
        "

        postBuildStep="$(MAKE) -C ${CCS_PROJECT_DIR} -f makefile_ccs_bootimage_gen OUTNAME=${BuildArtifactFileBaseName} PROFILE=${ConfigName} MCU_PLUS_SDK_PATH=${MCU_PLUS_SDK_PATH} CG_TOOL_ROOT=${CG_TOOL_ROOT} CCS_INSTALL_DIR=${CCS_INSTALL_DIR} CCS_IDE_MODE=${CCS_IDE_MODE} DEVICE=am263px"

        enableSysConfigTool="true"
        sysConfigBuildOptions="
            --context r5fss0-0 --part AM263P4 --package ZCZ_C
        "

        description="A Blower Imbalance NORTOS project">

        <configuration name="Debug"
            compilerBuildOptions="
                -D_DEBUG_=1
            "
            linkerBuildOptions="
                -lnortos.am263px.r5f.ti-arm-clang.debug.lib
                -ldrivers.am263px.r5f.ti-arm-clang.nortos.debug.lib
                -lcmsis.am263px.r5f.ti-arm-clang.$(PROFILE).lib
                -lmod.a
                -llibc.a
                -llibsysbm.a
            "
        ></configuration>
        <configuration name="Release"
            compilerBuildOptions="
                -Os
            "
            linkerBuildOptions="
                -lnortos.am263px.r5f.ti-arm-clang.release.lib
                -ldrivers.am263px.r5f.ti-arm-clang.nortos.release.lib
                -lcmsis.am263px.r5f.ti-arm-clang.$(PROFILE).lib
                -lmod.a
                -llibc.a
                -llibsysbm.a
            "
        ></configuration>
        <pathVariable name="MCU_PLUS_SDK_PATH" path="${COM_TI_MCU_PLUS_SDK_AMXXX_INSTALL_DIR}" scope="project" />
        <file path="../../../blower_imbalance.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../test_vector.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../main.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../../../../source/ai/feature_extract/feature_extract.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../../../../source/ai/feature_extract/feature_extract_am26.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../user_input_config.h" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../artifacts/tvmgen_default.h" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../artifacts/mod.a" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../example.syscfg" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${MCU_PLUS_SDK_PATH}/docs/api_guide_am263px/EXAMPLES_AI_BLOWER_IMBALANCE.html"
                openOnCreation="false" excludeFromBuild="false" targetName="README.html" action="link">
        </file>
        <file path="syscfg_c.rov.xs" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="makefile_ccs_bootimage_gen" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="makefile.defs" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
    </project>
</projectSpec>

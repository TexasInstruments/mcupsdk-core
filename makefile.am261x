	@echo  $(MAKE) -s -C examples/drivers/spinlock/spinlock_example/am261x-lp/system_nortos/ti-arm-clang [all clean syscfg-gui syscfg]
	@echo  $(MAKE) -s -C examples/drivers/tmu/tmu_cores_support/am261x-som/system_nortos/ti-arm-clang [all clean syscfg-gui syscfg]
	@echo  $(MAKE) -s -C examples/drivers/tmu/tmu_cores_support/am261x-lp/system_nortos/ti-arm-clang [all clean syscfg-gui syscfg]
	@echo  $(MAKE) -s -C examples/empty/am261x-som/system_freertos/ti-arm-clang [all clean syscfg-gui syscfg]
	@echo  $(MAKE) -s -C examples/empty/am261x-lp/system_freertos/ti-arm-clang [all clean syscfg-gui syscfg]
	@echo  $(MAKE) -s -C examples/empty/am261x-lp/system_freertos/iar-arm [all clean syscfg-gui syscfg]
	@echo  $(MAKE) -s -C examples/empty/am261x-som/system_nortos/ti-arm-clang [all clean syscfg-gui syscfg]
	@echo  $(MAKE) -s -C examples/empty/am261x-lp/system_nortos/ti-arm-clang [all clean syscfg-gui syscfg]
	@echo  $(MAKE) -s -C examples/empty/am261x-lp/system_nortos/iar-arm [all clean syscfg-gui syscfg]
	@echo  $(MAKE) -s -C examples/sdl/stc/stc_mcu/am261x-som/system_nortos_nortos/ti-arm-clang [all clean syscfg-gui syscfg]
	@echo  .


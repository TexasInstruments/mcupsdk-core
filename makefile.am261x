
all:
	$(MAKE) -f makefile.am261x libs
	$(MAKE) -f makefile.am261x sbl
	$(MAKE) -f makefile.am261x examples


clean: libs-clean sbl-clean examples-clean
scrub: libs-scrub sbl-scrub examples-scrub

help:
	@echo  Notes,
	@echo  - Use -j to invoke parallel builds
	@echo  - Use PROFILE=debug or PROFILE=release [default] to build in debug or release profile
	@echo  .
	@echo  Overall build targets,
	@echo  ======================
	@echo  $(MAKE) -s -f makefile.am261x help
	@echo  .
	@echo  $(MAKE) -s -f makefile.am261x all
	@echo  $(MAKE) -s -f makefile.am261x clean  # delete's tmp files for current profile
	@echo  $(MAKE) -s -f makefile.am261x scrub  # delete's all tmp files and folders for all profiles
	@echo  .
	@echo  $(MAKE) -s -f makefile.am261x libs
	@echo  $(MAKE) -s -f makefile.am261x libs-clean # delete's tmp files for current profile
	@echo  $(MAKE) -s -f makefile.am261x libs-scrub # delete's all tmp files and folders for all profiles
	@echo  .
	@echo  $(MAKE) -s -f makefile.am261x examples
	@echo  $(MAKE) -s -f makefile.am261x examples-clean # delete's tmp files for current profile
	@echo  $(MAKE) -s -f makefile.am261x examples-scrub # delete's all tmp files and folders for all profiles
	@echo  .
	@echo  Library build targets,
	@echo  ======================
